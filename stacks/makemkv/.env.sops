# Host-specific deployment configuration for the makemkv stack.
# Every value here is host-specific by design — the compose.yaml is shared
# across every host that runs this, only this file differs per deployment.
# apps service user (uid/gid 2000), matching house convention
MAKEMKV_UID=2000
MAKEMKV_GID=2000
TZ=America/Los_Angeles
# host paths
MAKEMKV_CONFIG=/mnt/data/makemkv/config
MAKEMKV_OUTPUT=/mnt/data/makemkv/output
MAKEMKV_COMPLETED=/mnt/data/makemkv/completed
# the optical drive to pass through. Both device nodes point at the same
# physical drive - /dev/sr0 is the block device, /dev/sg0 is the SCSI
# generic device MakeMKV needs for direct disc access. Find the matching
# pair with: udevadm info --query=all --name=/dev/sr0
MAKEMKV_DEVICE_SR=/dev/sr0
MAKEMKV_DEVICE_SG=/dev/sg0
# web UI port
MAKEMKV_PORT=5800
# MakeMKV registration key. Leave as BETA to run on MakeMKV's rotating
# beta key (works fine, just needs the container restarted periodically
# as the beta key expires). Set to a real key if one is ever purchased.
MAKEMKV_KEY=ENC[AES256_GCM,data:cGDQjw==,iv:2dA+DQ0uxUtvjB2x99Z4N2nejrPn9NxmHp1q4oM9yKo=,tag:jXaW9IGMD8vGVmPj+//Bfw==,type:str]
# Minimum title length (seconds) for the automatic disc ripper to bother
# extracting - filters out menus/previews/trailers. 300s (5min) is short
# enough to keep TV episodes, long enough to skip disc junk.
MAKEMKV_MIN_TITLE_LENGTH=300
# name shown in ntfy notification titles from ./hooks/*.sh
MAKEMKV_HOST_LABEL=makemkv-crafty
# ntfy.sh topic for rip-start/rip-finished notifications (the "ready"
# category), reused from the arm stack's existing topic
NTFY_TOPIC_READY=ENC[AES256_GCM,data:3p8QSI7Y9XZNQ3Wj8ztYcGjesndy,iv:Rrn8W3Mbd2SuVMiipejin0myz9R251zr2LEFILgRV70=,tag:+nERT68nsebpGCaNtLMyHA==,type:str]
