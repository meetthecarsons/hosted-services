# Host-specific deployment configuration for the palworld stack.
# apps service user (uid/gid 2000), matching house convention — set via
# PUID/PGID directly in compose.yaml, no override needed here.
TZ=America/Los_Angeles
# host path holding SaveGames, backups, and generated configs
DATA_DIR=/mnt/data/palworld
PLAYERS="16"
SERVER_NAME="For the chuds"
SERVER_DESCRIPTION="Change Me"
# RCON default (25575) collides with minecraft-java's RCON port on the same
# host — palworld uses 25576 instead.
RCON_PORT=25576
# Docker-level memory cap (defense in depth alongside AUTO_REBOOT below,
# against Palworld's known long-uptime memory leak) — sized against
# crafty's total RAM, leaving headroom for minecraft-java and the OS.
MEM_LIMIT=16g
# Palworld's memory leak grows with uptime regardless of player count.
# AUTO_REBOOT (compose.yaml, daily 4am) is the primary mitigation;
# MEM_LIMIT above is the backstop if it climbs faster than expected.
# Secrets — real values live in .env.sops, not here.
