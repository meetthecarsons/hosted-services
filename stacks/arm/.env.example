# Host-specific deployment configuration for the arm stack.
# Every value here is host-specific by design — the compose.yaml is shared
# across every host that runs ARM; only this file differs per deployment.

# apps service user (uid/gid 2000), matching house convention
ARM_UID=2000
ARM_GID=2000

TZ=America/Los_Angeles

# host paths
ARM_HOME=/mnt/data/arm/home
ARM_MUSIC=/mnt/data/arm/music
ARM_LOGS=/mnt/data/arm/logs
ARM_MEDIA=/mnt/data/arm/media

# web UI port
ARM_PORT=8080

# friendly name for this instance, shown in notification titles
ARM_NAME=arm-crafty

# MakeMKV registration key. Leave empty to run on MakeMKV's rotating beta
# key instead (works fine, just needs the container restarted periodically
# as the beta key expires).
MAKEMKV_PERMA_KEY=

# omdbapi.com API key, for automatic disc/title identification
OMDB_API_KEY=
