# Host-specific deployment configuration for the arm stack.
# Every value here is host-specific by design — the compose.yaml is shared
# across every host that runs ARM; only this file differs per deployment.

# apps service user (uid/gid 2000), matching house convention
ARM_UID=2000
ARM_GID=2000

TZ=America/Los_Angeles

# host paths
ARM_HOME=/mnt/data/arm/home
ARM_MUSIC=/mnt/data/arm/music
ARM_LOGS=/mnt/data/arm/logs
ARM_MEDIA=/mnt/data/arm/media

# web UI port
ARM_PORT=8080

# friendly name for this instance, shown in notification titles
ARM_NAME=arm-crafty

# MakeMKV registration key. Leave empty to run on MakeMKV's rotating beta
# key instead (works fine, just needs the container restarted periodically
# as the beta key expires).
MAKEMKV_PERMA_KEY=

# Metadata provider for automatic disc/title identification. arm.yaml sets
# METADATA_PROVIDER: "tmdb" (movies only, but that's all this ripper does),
# so TMDB_API_KEY is the one that matters; OMDB_API_KEY is wired but unused
# unless METADATA_PROVIDER is switched back to "omdb" in the template. Use
# TMDB's v3 "API Key", not the v4 "API Read Access Token" — ARM's code
# passes it as an api_key= query param, not a bearer token.
OMDB_API_KEY=
TMDB_API_KEY=

# ntfy.sh topic for rip-complete notifications (the "ready" category —
# audible, distinct from the silent info/alert topics). Topic names are
# secrets; see explanation/alerting-design.md in the outer repo.
NTFY_TOPIC=
