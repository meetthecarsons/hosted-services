# Environment file for Audiobookshelf stack (tracked in repo)
# Adjust values as required for the host.

# apps service user (uid/gid 2000), matching house convention
PUID=2000
PGID=2000

# timezone
TZ=America/Los_Angeles

# host paths for Audiobookshelf data (replace with your own mount points)
ABS_CONFIG=/mnt/fast-pool-01/appdata/audiobookshelf/config
ABS_METADATA=/mnt/fast-pool-01/appdata/audiobookshelf/metadata
ABS_AUDIOBOOKS=/mnt/bulk-pool-01/data/media/audiobooks

# Port mapping for direct LAN access (update if you want a different host port)
ABS_PORT=13378

# Tailscale auth key for the audiobookshelf-ts sidecar (generate at https://login.tailscale.com/admin/settings/keys)
TS_AUTH_KEY=tskey-auth-REPLACE_ME
