# Host-specific deployment configuration for the syncthing stack.
# The compose.yaml is shared; only this file differs per deployment.

# apps service user (uid/gid 2000), matching house convention
PUID=2000
PGID=2000

# This host's own Tailscale IP (not a stack-issued sidecar address — see
# compose.yaml). All Syncthing ports bind here only.
TS_ADDR=100.93.184.18

# Syncthing's own config/state (device ID, certs, folder definitions) —
# app state, lives on the ZFS pool like other Docker app state.
SYNCTHING_CONFIG=/mnt/fast-pool-01/appdata/syncthing

# Landing paths for the two synced folders (see
# planning/investigate-syncthing.md and planning/audiobook-library.md in
# the outer repo for why these live on different pools):
#   - audiobooks: bulk pool, no backup, re-acquirable if lost. Lands in
#     _incoming, not the live library root — each Libro.fm download is a
#     .zip, and turning that into a per-book folder Audiobookshelf can read
#     is a separate, not-yet-built step (see audiobook-library.md).
#   - sms-backup: ZFS mirror, snapshotted + offsite backed up, irreplaceable
SYNCTHING_AUDIOBOOKS_DIR=/mnt/bulk-pool-01/data/media/audiobooks/_incoming
SYNCTHING_SMS_DIR=/mnt/fast-pool-01/documents/sms-backup
