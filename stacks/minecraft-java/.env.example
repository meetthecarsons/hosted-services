# Host-specific deployment configuration
DATA_DIR=/opt/data/minecraft-java/data

VERSION="26.2"
DIFFICULTY="easy"
MODE="survival"
# Optional; defaults to a normal "world" save if unset. Override both to
# stand up a second world (e.g. LEVEL="flat_event", LEVEL_TYPE="FLAT") without
# touching the existing save — the itzg image generates a new folder per LEVEL.
LEVEL="world"
LEVEL_TYPE="DEFAULT"
MAX_PLAYERS="10"
OPS="fourdirections,wifuy"
WHITELIST="fourdirections,wifuy"
INIT_MEMORY="2G"
MAX_MEMORY="4G"

# RCON
RCON_PASSWORD=changeme
