# Environment file for Navidrome stack (tracked in repo)
# Adjust values as required for the host.

# host paths for Navidrome data (replace with your own mount points)
NAVIDROME_DATA=/mnt/fast-pool-01/appdata/navidrome
NAVIDROME_MUSIC=/mnt/bulk-pool-01/data/media/music

# How often Navidrome rescans the music folder for changes
ND_SCANSCHEDULE=1h

# error / info / debug / trace
ND_LOGLEVEL=info

# How long a login session stays valid before requiring re-auth
ND_SESSIONTIMEOUT=24h

# Port mapping for direct LAN access (update if you want a different host port)
NAVIDROME_PORT=4533

# Tailscale auth key for the navidrome-ts sidecar (generate at https://login.tailscale.com/admin/settings/keys)
TS_AUTH_KEY=tskey-auth-REPLACE_ME
