# Environment file for librofm-downloader stack (tracked in repo)
# Adjust values as required for the host.

# host paths for librofm-downloader data (replace with your own mount points)
LIBROFM_DATA=/mnt/fast-pool-01/appdata/librofm-downloader
LIBROFM_MEDIA=/mnt/bulk-pool-01/data/media/audiobooks

# Libro.fm account credentials — the account this polls for new purchases.
# Note: passwords containing `$` need escaping as `$$` in this file, or
# docker-compose will try to interpolate them as variable references.
LIBRO_FM_USERNAME=REPLACE_ME
LIBRO_FM_PASSWORD=REPLACE_ME

# Download format: MP3, M4B_MP3_FALLBACK (default), or M4B_CONVERT_FALLBACK
FORMAT=M4B_MP3_FALLBACK

# How often to check for new purchases: h (hourly), d (daily), w (weekly)
SYNC_INTERVAL=h

# Parallel download count — increase with care, memory usage scales with it
PARALLEL_COUNT=1

# NONE / INFO / VERBOSE
LOG_LEVEL=INFO

# Rename chapter files and write ID3 title tags from Libro.fm's own
# metadata — audiobook torrent releases have shown how little embedded
# metadata can otherwise be trusted, so both default on here.
RENAME_CHAPTERS=true
WRITE_TITLE_TAG=true

# Destination folder pattern within /media — see the project's README for
# all available tokens (SERIES_NAME, FIRST_NARRATOR, ISBN, etc.)
PATH_PATTERN=FIRST_AUTHOR/BOOK_TITLE

# Port mapping for direct LAN access (update if you want a different host port)
LIBROFM_PORT=8090

# Tailscale auth key for the librofm-downloader-ts sidecar (generate at https://login.tailscale.com/admin/settings/keys)
TS_AUTH_KEY=tskey-auth-REPLACE_ME
