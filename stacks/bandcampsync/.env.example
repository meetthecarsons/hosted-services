# Environment file for bandcampsync stack (tracked in repo)
# Adjust values as required for the host.

# apps service user (uid/gid 2000), matching house convention
PUID=2000
PGID=2000

# timezone
TZ=America/Los_Angeles

# host paths for bandcampsync data (replace with your own mount points)
BANDCAMPSYNC_CONFIG=/mnt/fast-pool-01/appdata/bandcampsync
BANDCAMPSYNC_DOWNLOADS=/mnt/bulk-pool-01/data/media/music

# Hour of day (0-23, local time) bandcampsync runs its daily sync
RUN_DAILY_AT=3

# Download format requested from Bandcamp for every release — a single
# global setting, not per-release auto-selection. If a release doesn't
# offer this exact encoding the item fails rather than falling back.
# Options: mp3-v0, mp3-320, flac (default), aac-hi, aiff-lossless, vorbis,
# alac, wav
FORMAT=flac

# Optional: HTTP GET/POST to call when new items are downloaded — see the
# project's README for the "method url headers body" advanced format.
# Leave blank to disable.
NOTIFY_URL=
